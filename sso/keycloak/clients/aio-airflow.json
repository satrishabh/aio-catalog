{
  "clientId": "aio-airflow",
  "name": "Apache Airflow (AIO managed)",
  "protocol": "openid-connect",
  "publicClient": false,
  "standardFlowEnabled": true,
  "directAccessGrantsEnabled": false,
  "implicitFlowEnabled": false,
  "serviceAccountsEnabled": false,
  "redirectUris": [
    "https://airflow.tools.sarvaikam.com/auth/oauth-authorized/keycloak"
  ],
  "webOrigins": [
    "https://airflow.tools.sarvaikam.com"
  ],
  "attributes": {
    "pkce.code.challenge.method": "S256",
    "post.logout.redirect.uris": "https://airflow.tools.sarvaikam.com/*"
  },
  "defaultClientScopes": [
    "openid",
    "email",
    "profile",
    "roles"
  ],
  "x-aio-roles": [
    "aio-admin",
    "aio-business"
  ],
  "protocolMappers": [
    {
      "name": "client roles as groups",
      "protocol": "openid-connect",
      "protocolMapper": "oidc-usermodel-client-role-mapper",
      "config": {
        "usermodel.clientRoleMapping.clientId": "aio-airflow",
        "claim.name": "groups",
        "jsonType.label": "String",
        "multivalued": "true",
        "id.token.claim": "true",
        "access.token.claim": "true",
        "userinfo.token.claim": "true"
      }
    }
  ]
}